{
  "name": "kompress",
  "version": "1.3.1",
  "description": "A simple multimedia file compressor for macOS",
  "type": "module",
  "license": "MIT",
  "author": "Sam Kasman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samkasman/kompress.git"
  },
  "homepage": "https://github.com/samkasman/kompress",
  "bugs": {
    "url": "https://github.com/samkasman/kompress/issues"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build && node scripts/sign-and-copy-release.js",
    "tauri:build:aarch64": "tauri build --target aarch64-apple-darwin && node scripts/sign-and-copy-release.js",
    "release": "node scripts/release.js",
    "release:local": "node scripts/release.js --local",
    "release:patch": "bash bin/cut-release.sh patch --yes",
    "release:minor": "bash bin/cut-release.sh minor --yes",
    "release:major": "bash bin/cut-release.sh major --yes",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "verify": "bash scripts/verify-conversions.sh",
    "test": "vitest",
    "test:run": "vitest run",
    "changelog:draft": "git-cliff --unreleased",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{js,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "git-cliff": "^2.13.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
